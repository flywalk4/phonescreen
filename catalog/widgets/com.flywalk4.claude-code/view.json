{
 "full": {
  "type": "vstack",
  "spacing": 14,
  "align": "leading",
  "children": [
   {
    "type": "hstack",
    "spacing": 8,
    "children": [
     {
      "type": "text",
      "text": "✳",
      "size": 15,
      "weight": "bold",
      "color": "#D97757"
     },
     {
      "type": "text",
      "text": "CLAUDE CODE",
      "style": "caption",
      "weight": "semibold",
      "color": "secondary"
     },
     {
      "type": "spacer"
     },
     {
      "type": "text",
      "text": "{{model}}",
      "style": "caption",
      "weight": "semibold",
      "color": "secondary"
     }
    ]
   },
   {
    "type": "box",
    "padding": 18,
    "spacing": 12,
    "align": "center",
    "children": [
     {
      "type": "sprite",
      "frames": "{{mascot.frames}}",
      "fps": "{{mascot.fps}}",
      "palette": {
       "o": "#D97757",
       "d": "#A85A40",
       "k": "#2B1B14",
       "y": "#F5C542",
       "w": "#FFFFFF"
      }
     },
     {
      "type": "box",
      "fit": true,
      "padding": 7,
      "radius": 10,
      "background": "{{moodColor}}",
      "opacity": 0.18,
      "children": [
       {
        "type": "text",
        "text": "{{moodText}}",
        "style": "headline",
        "color": "{{moodColor}}"
       }
      ]
     }
    ]
   },
   {
    "type": "hstack",
    "spacing": 10,
    "align": "top",
    "children": [
     {
      "type": "box",
      "padding": 14,
      "spacing": 6,
      "if": "{{five.has}}",
      "children": [
       {
        "type": "text",
        "text": "5 ЧАСОВ",
        "style": "caption",
        "weight": "semibold",
        "color": "secondary"
       },
       {
        "type": "text",
        "text": "{{five.pct}}",
        "size": 30,
        "weight": "bold",
        "design": "rounded",
        "color": "{{five.color}}",
        "lines": 1
       },
       {
        "type": "progress",
        "if": "{{five.bar}}",
        "value": "{{five.value}}",
        "color": "{{five.color}}"
       },
       {
        "type": "text",
        "text": "{{five.reset}}",
        "style": "caption2",
        "color": "secondary",
        "lines": 2
       }
      ]
     },
     {
      "type": "box",
      "padding": 14,
      "spacing": 6,
      "if": "{{week.has}}",
      "children": [
       {
        "type": "text",
        "text": "НЕДЕЛЯ",
        "style": "caption",
        "weight": "semibold",
        "color": "secondary"
       },
       {
        "type": "text",
        "text": "{{week.pct}}",
        "size": 30,
        "weight": "bold",
        "design": "rounded",
        "color": "{{week.color}}",
        "lines": 1
       },
       {
        "type": "progress",
        "if": "{{week.bar}}",
        "value": "{{week.value}}",
        "color": "{{week.color}}"
       },
       {
        "type": "text",
        "text": "{{week.reset}}",
        "style": "caption2",
        "color": "secondary",
        "lines": 2
       }
      ]
     }
    ]
   },
   {
    "type": "text",
    "if": "{{note}}",
    "style": "footnote",
    "color": "secondary",
    "text": "{{note}}"
   }
  ]
 },
 "medium": {
  "type": "hstack",
  "spacing": 14,
  "align": "center",
  "children": [
   {
    "type": "vstack",
    "spacing": 8,
    "align": "center",
    "children": [
     {
      "type": "sprite",
      "frames": "{{mascot.frames}}",
      "fps": "{{mascot.fps}}",
      "palette": {
       "o": "#D97757",
       "d": "#A85A40",
       "k": "#2B1B14",
       "y": "#F5C542",
       "w": "#FFFFFF"
      }
     },
     {
      "type": "text",
      "text": "{{moodText}}",
      "style": "caption",
      "weight": "semibold",
      "color": "{{moodColor}}",
      "lines": 1
     }
    ]
   },
   {
    "type": "vstack",
    "spacing": 10,
    "align": "leading",
    "children": [
     {
      "type": "vstack",
      "spacing": 3,
      "align": "leading",
      "if": "{{five.has}}",
      "children": [
       {
        "type": "hstack",
        "children": [
         {
          "type": "text",
          "text": "5 ч",
          "style": "caption",
          "weight": "semibold",
          "color": "secondary"
         },
         {
          "type": "spacer"
         },
         {
          "type": "text",
          "text": "{{five.pct}}",
          "size": 22,
          "weight": "bold",
          "design": "rounded",
          "color": "{{five.color}}"
         }
        ]
       },
       {
        "type": "progress",
        "if": "{{five.bar}}",
        "value": "{{five.value}}",
        "color": "{{five.color}}"
       },
       {
        "type": "text",
        "text": "{{five.reset}}",
        "style": "caption2",
        "color": "secondary",
        "lines": 1
       }
      ]
     },
     {
      "type": "vstack",
      "spacing": 3,
      "align": "leading",
      "if": "{{week.has}}",
      "children": [
       {
        "type": "hstack",
        "children": [
         {
          "type": "text",
          "text": "Неделя",
          "style": "caption",
          "weight": "semibold",
          "color": "secondary"
         },
         {
          "type": "spacer"
         },
         {
          "type": "text",
          "text": "{{week.pct}}",
          "size": 22,
          "weight": "bold",
          "design": "rounded",
          "color": "{{week.color}}"
         }
        ]
       },
       {
        "type": "progress",
        "if": "{{week.bar}}",
        "value": "{{week.value}}",
        "color": "{{week.color}}"
       },
       {
        "type": "text",
        "text": "{{week.reset}}",
        "style": "caption2",
        "color": "secondary",
        "lines": 1
       }
      ]
     },
     {
      "type": "text",
      "if": "{{noteShort}}",
      "style": "caption2",
      "color": "secondary",
      "text": "{{noteShort}}",
      "lines": 2
     }
    ]
   }
  ]
 },
 "small": {
  "type": "vstack",
  "spacing": 6,
  "align": "leading",
  "children": [
   {
    "type": "sprite",
    "frames": "{{mascot.frames}}",
    "fps": "{{mascot.fps}}",
    "palette": {
     "o": "#D97757",
     "d": "#A85A40",
     "k": "#2B1B14",
     "y": "#F5C542",
     "w": "#FFFFFF"
    }
   },
   {
    "type": "text",
    "text": "{{moodText}}",
    "style": "caption",
    "weight": "semibold",
    "color": "{{moodColor}}",
    "lines": 1
   },
   {
    "type": "spacer"
   },
   {
    "type": "hstack",
    "children": [
     {
      "type": "text",
      "text": "5ч",
      "style": "caption",
      "color": "secondary"
     },
     {
      "type": "spacer"
     },
     {
      "type": "text",
      "text": "{{five.pct}}",
      "size": 18,
      "weight": "bold",
      "design": "rounded",
      "color": "{{five.color}}"
     }
    ]
   },
   {
    "type": "hstack",
    "children": [
     {
      "type": "text",
      "text": "нед",
      "style": "caption",
      "color": "secondary"
     },
     {
      "type": "spacer"
     },
     {
      "type": "text",
      "text": "{{week.pct}}",
      "size": 18,
      "weight": "bold",
      "design": "rounded",
      "color": "{{week.color}}"
     }
    ]
   }
  ]
 }
}