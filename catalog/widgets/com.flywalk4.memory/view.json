            "color": "{{statusColor}}",
            "lines": 2
          },
          {
            "type": "spacer"
          },
          {
            "type": "button",
            "title": "{{t.restart}}",
            "symbol": "arrow.clockwise",
            "action": "new",
            "color": "pink"
          }
        ]
      }
    ]
  },
  "small": {
    "type": "vstack",
    "spacing": 10,
    "align": "leading",
    "children": [
      {
        "type": "hstack",
        "spacing": 6,
        "children": [
          {
            "type": "symbol",
            "name": "brain.head.profile",
            "color": "pink",
            "size": 13
          },
          {
            "type": "text",
            "text": "{{pairs}}",
            "style": "subheadline",
            "weight": "bold",
            "design": "rounded"
          },
          {
            "type": "spacer"
          },
          {
            "type": "button",
            "title": "",
            "symbol": "arrow.clockwise",
            "action": "new"
          }
        ]
      },
      {
        "type": "list",
        "items": "{{cards}}",
        "columns": 4,
        "spacing": 8,
        "template": {
          "type": "box",
          "aspect": 1,
          "padding": 0,
          "radius": 14,
          "background": "{{item.bg}}",
          "opacity": "{{item.opacity}}",
          "action": "{{item.action}}",
          "children": [
            {
              "type": "text",
              "text": "{{item.face}}",
              "size": 40,
              "weight": "bold",
              "design": "rounded",
              "color": "{{item.faceColor}}"
            }
          ]
        }
      },
      {
        "type": "text",
        "text": "{{movesLine}}",
        "style": "caption",
        "weight": "semibold",
        "color": "secondary",
        "lines": 1
      }
    ]
  }
}
