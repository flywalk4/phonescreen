{
  "full": {
    "type": "vstack",
    "spacing": 14,
    "align": "leading",
    "children": [
      {
        "type": "hstack",
        "spacing": 8,
        "children": [
          {
            "type": "hstack",
            "spacing": 6,
            "children": [
              {
                "type": "symbol",
                "name": "brain.head.profile",
                "color": "pink",
                "size": 14
              },
              {
                "type": "text",
                "text": "{{t.header}}",
                "style": "caption",
                "weight": "bold",
                "color": "pink"
              }
            ]
          },
          {
            "type": "spacer"
          },
          {
            "type": "text",
            "text": "{{t.best}}: {{best}}",
            "style": "caption",
            "color": "secondary",
            "lines": 1
          }
        ]
      },
      {
        "type": "hstack",
        "spacing": 10,
        "children": [
          {
            "type": "box",
            "padding": 10,
            "radius": 12,
            "align": "center",
            "spacing": 0,
            "children": [
              {
                "type": "text",
                "text": "{{moves}}",
                "size": 22,
                "weight": "bold",
                "design": "rounded",
                "lines": 1
              },
              {
                "type": "text",
                "text": "{{t.movesLabel}}",
                "style": "caption2",
                "color": "secondary",
                "lines": 1
              }
            ]
          },
          {
            "type": "box",
            "padding": 10,
            "radius": 12,
            "align": "center",
            "spacing": 0,
            "children": [
              {
                "type": "text",
                "text": "{{pairs}}",
                "size": 22,
                "weight": "bold",
                "design": "rounded",
                "lines": 1,
                "color": "green"
              },
              {
                "type": "text",
                "text": "{{t.pairsLabel}}",
                "style": "caption2",
                "color": "secondary",
                "lines": 1
              }
            ]
          }
        ]
      },
      {
        "type": "list",
        "items": "{{cards}}",
        "columns": 4,
        "spacing": 8,
        "template": {
          "type": "box",
          "aspect": 1,
          "padding": 0,
          "radius": 14,
          "background": "{{item.bg}}",
          "opacity": "{{item.opacity}}",
          "action": "{{item.action}}",
          "children": [
            {
              "type": "text",
              "text": "{{item.face}}",
              "size": 40,
              "weight": "bold",
              "design": "rounded",
              "color": "{{item.faceColor}}"
            }
          ]
        }
      },
      {
        "type": "hstack",
        "spacing": 8,
        "children": [
          {
            "type": "text",
            "text": "{{status}}",
            "style": "headline",
            "color": "{{statusColor}}",
            "lines": 2
          },
          {
            "type": "spacer"
          },
          {
            "type": "button",
            "title": "{{t.restart}}",
            "symbol": "arrow.clockwise",
            "action": "new",
            "color": "pink"
          }
        ]
      }
    ]
  },
  "medium": {
