{
  "id": "com.flywalk4.rates",
  "name": "Курсы валют",
  "version": "1.2.1",
  "author": "flywalk4",
  "description": "Курсы валют к рублю (или другой валюте) по данным open.er-api.com, с графиком изменений.",
  "symbol": "dollarsign.arrow.circlepath",
  "refresh": 1800,
  "permissions": {
    "network": [
      "open.er-api.com"
    ]
  },
  "settings": [
    {
      "key": "target",
      "title": "Показывать в",
      "type": "choice",
      "default": "RUB",
      "options": [
        "RUB",
        "USD",
        "EUR",
        "CNY",
        "KZT",
        "GBP",
        "TRY",
        "JPY"
      ]
    },
    {
      "key": "codes",
      "title": "Валюты",
      "default": "USD,EUR,CNY",
      "hint": "Коды через запятую: USD, EUR, CNY"
    }
  ]
}
