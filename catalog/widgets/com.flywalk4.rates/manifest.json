{
  "id": "com.flywalk4.rates",
  "name": "Exchange rates",
  "version": "1.3.0",
  "author": "flywalk4",
  "description": "Exchange rates against the ruble (or another currency) from open.er-api.com, with a chart of changes.",
  "symbol": "dollarsign.arrow.circlepath",
  "refresh": 1800,
  "permissions": {
    "network": [
      "open.er-api.com"
    ]
  },
  "settings": [
    {
      "key": "target",
      "title": "Show in",
      "type": "choice",
      "default": "RUB",
      "options": [
        "RUB",
        "USD",
        "EUR",
        "CNY",
        "KZT",
        "GBP",
        "TRY",
        "JPY"
      ]
    },
    {
      "key": "codes",
      "title": "Currencies",
      "default": "USD,EUR,CNY",
      "hint": "Comma-separated codes: USD, EUR, CNY"
    }
  ]
}
