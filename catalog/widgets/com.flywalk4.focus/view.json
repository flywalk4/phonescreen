{
  "full": {
    "type": "vstack",
    "spacing": 14,
    "align": "leading",
    "children": [
      {
        "type": "hstack",
        "spacing": 8,
        "children": [
          {
            "type": "symbol",
            "name": "timer",
            "color": "{{color}}",
            "size": 15
          },
          {
            "type": "text",
            "text": "{{t.header}}",
            "style": "caption",
            "weight": "semibold",
            "color": "secondary"
          }
        ]
      },
      {
        "type": "box",
        "padding": 20,
        "spacing": 14,
        "align": "center",
        "children": [
          {
            "type": "box",
            "fit": true,
            "padding": 7,
            "radius": 10,
            "background": "{{color}}",
            "opacity": 0.18,
            "children": [
              {
                "type": "hstack",
                "spacing": 6,
                "children": [
                  {
                    "type": "symbol",
                    "name": "{{icon}}",
                    "color": "{{color}}",
                    "size": 14
                  },
                  {
                    "type": "text",
                    "text": "{{phase}}",
                    "style": "subheadline",
                    "weight": "semibold",
                    "color": "{{color}}"
                  }
                ]
              }
            ]
          },
          {
            "type": "gauge",
            "value": "{{progress}}",
            "text": "{{time}}",
            "color": "{{color}}",
            "fill": true
          },
          {
            "type": "text",
            "text": "{{until}}",
            "style": "subheadline",
            "color": "secondary"
          }
        ]
      },
      {
        "type": "hstack",
        "spacing": 10,
        "children": [
          {
            "type": "button",
            "title": "{{toggleTitle}}",
            "symbol": "{{toggleSymbol}}",
            "action": "toggle"
          },
          {
            "type": "button",
            "title": "{{t.reset}}",
            "symbol": "arrow.uturn.backward",
            "action": "reset"
          },
          {
            "type": "spacer"
          },
          {
            "type": "button",
            "title": "{{t.skip}}",
            "symbol": "forward.fill",
            "action": "skip"
          }
        ]
      },
      {
        "type": "spacer"
      },
      {
        "type": "box",
        "padding": 16,
        "spacing": 8,
        "children": [
          {
            "type": "hstack",
            "children": [
              {
                "type": "text",
                "text": "{{t.todayTitle}}",
                "style": "headline"
              },
              {
                "type": "spacer"
              },
              {
                "type": "text",
                "text": "{{focusLine}}",
                "style": "subheadline",
                "color": "secondary"
              }
            ]
          },
          {
            "type": "hstack",
            "align": "baseline",
            "spacing": 6,
            "children": [
              {
                "type": "text",
                "text": "{{done}}",
                "size": 40,
                "weight": "bold",
                "design": "rounded"
              },
              {
                "type": "text",
                "text": "{{goalLine}}",
                "style": "subheadline",
                "color": "secondary"
              }
            ]
          },
          {
            "type": "text",
            "text": "{{dots}}",
            "style": "title3",
            "color": "orange"
          },
          {
            "type": "text",
            "text": "{{next}}",
            "style": "caption",
            "color": "secondary"
          }
        ]
      }
    ]
  },
  "medium": {
    "type": "vstack",
    "spacing": 12,
    "align": "leading",
    "children": [
      {
        "type": "hstack",
        "children": [
          {
            "type": "box",
            "fit": true,
            "padding": 5,
            "radius": 8,
            "background": "{{color}}",
            "opacity": 0.18,
            "children": [
              {
                "type": "hstack",
                "spacing": 5,
                "children": [
                  {
                    "type": "symbol",
                    "name": "{{icon}}",
                    "color": "{{color}}",
                    "size": 12
                  },
                  {
                    "type": "text",
                    "text": "{{phase}}",
                    "style": "caption",
                    "weight": "semibold",
                    "color": "{{color}}"
                  }
                ]
              }
            ]
          },
          {
            "type": "spacer"
          },
          {
            "type": "text",
            "text": "{{done}}/{{goal}} 🍅",
            "style": "subheadline",
            "weight": "semibold"
          }
        ]
      },
      {
        "type": "text",
        "text": "{{time}}",
        "size": 64,
        "weight": "bold",
        "design": "rounded",
        "lines": 1
      },
      {
        "type": "progress",
        "value": "{{progress}}",
        "color": "{{color}}"
      },
      {
        "type": "text",
        "text": "{{until}}",
        "style": "footnote",
        "color": "secondary"
      },
      {
        "type": "spacer"
      },
      {
        "type": "vstack",
        "spacing": 4,
        "align": "leading",
        "children": [
          {
            "type": "text",
            "text": "{{dots}}",
            "style": "title3",
            "color": "{{color}}",
            "lines": 1
          },
          {
            "type": "text",
            "text": "{{todayLine}}",
            "style": "caption",
            "color": "secondary"
          }
        ]
      },
      {
        "type": "spacer"
      },
      {
        "type": "hstack",
        "spacing": 8,
        "children": [
          {
            "type": "button",
            "title": "{{toggleTitle}}",
            "symbol": "{{toggleSymbol}}",
            "action": "toggle"
          },
          {
            "type": "button",
            "title": "{{t.reset}}",
            "symbol": "arrow.uturn.backward",
            "action": "reset"
          },
          {
            "type": "spacer"
          },
          {
            "type": "button",
            "title": "{{t.skipShort}}",
            "symbol": "forward.fill",
            "action": "skip"
          }
        ]
      }
    ]
  },
  "small": {
    "type": "vstack",
    "spacing": 8,
    "align": "center",
    "children": [
      {
        "type": "hstack",
        "spacing": 5,
        "children": [
          {
            "type": "symbol",
            "name": "{{icon}}",
            "color": "{{color}}",
            "size": 13
          },
          {
            "type": "text",
            "text": "{{phase}}",
            "style": "caption",
            "weight": "semibold",
            "color": "{{color}}",
            "lines": 1
          }
        ]
      },
      {
        "type": "gauge",
        "value": "{{progress}}",
        "text": "{{time}}",
        "color": "{{color}}",
        "fill": true
      },
      {
        "type": "text",
        "text": "{{done}} {{t.of}} {{goal}} 🍅",
        "style": "caption",
        "color": "secondary",
        "align": "center"
      },
      {
        "type": "button",
        "title": "{{toggleTitle}}",
        "symbol": "{{toggleSymbol}}",
        "action": "toggle"
      }
    ]
  }
}
