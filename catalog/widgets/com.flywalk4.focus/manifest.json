{
  "id": "com.flywalk4.focus",
  "name": "Focus",
  "version": "1.4.0",
  "author": "flywalk4",
  "description": "A Pomodoro timer: 25 minutes of work, a 5-minute break, a long break after four. Start, pause and skip right from the phone; a count of today's pomodoros. Works offline.",
  "symbol": "timer",
  "refresh": 5,
  "settings": [
    {
      "key": "focus",
      "title": "Work",
      "type": "number",
      "default": "25",
      "min": 5,
      "max": 90,
      "step": 5,
      "unit": "min"
    },
    {
      "key": "short",
      "title": "Short break",
      "type": "number",
      "default": "5",
      "min": 1,
      "max": 30,
      "unit": "min"
    },
    {
      "key": "long",
      "title": "Long break",
      "type": "number",
      "default": "15",
      "min": 5,
      "max": 60,
      "step": 5,
      "unit": "min"
    },
    {
      "key": "every",
      "title": "Long break after",
      "type": "number",
      "default": "4",
      "min": 2,
      "max": 8,
      "unit": "pomodoros"
    },
    {
      "key": "goal",
      "title": "Daily goal",
      "type": "number",
      "default": "8",
      "min": 1,
      "max": 20,
      "unit": "pomodoros"
    }
  ]
}
