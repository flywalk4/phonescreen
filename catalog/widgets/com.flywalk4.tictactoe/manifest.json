  "settings": [
    {
      "key": "level",
      "title": "Difficulty",
      "type": "choice",
      "default": "normal",
      "options": [
        {
          "value": "easy",
          "title": "Easy"
        },
        {
          "value": "normal",
          "title": "Normal"
        },
        {
          "value": "hard",
          "title": "Unbeatable"
        }
      ]
    }
  ]
}
