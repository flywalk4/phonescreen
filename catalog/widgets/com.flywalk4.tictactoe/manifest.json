{
  "id": "com.flywalk4.tictactoe",
  "name": "Tic-tac-toe",
  "version": "1.3.0",
  "author": "flywalk4",
  "description": "Tic-tac-toe against the Mac: move with a finger or the cursor, the Mac answers. Three difficulty levels, a game score, and you take turns going first.",
