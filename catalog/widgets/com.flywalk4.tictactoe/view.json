{
  "full": {
    "type": "vstack",
    "spacing": 14,
    "align": "leading",
    "children": [
      {
        "type": "hstack",
        "spacing": 8,
        "children": [
          {
            "type": "hstack",
            "spacing": 6,
            "children": [
              {
                "type": "text",
                "text": "✕◯",
                "size": 13,
                "weight": "heavy",
                "color": "orange"
              },
              {
                "type": "text",
                "text": "{{t.header}}",
                "style": "caption",
                "weight": "bold",
                "color": "orange"
              }
            ]
          },
          {
            "type": "spacer"
          },
          {
            "type": "text",
            "text": "Mac: {{level}}",
            "style": "caption",
            "color": "secondary",
            "lines": 1
          }
        ]
      },
      {
        "type": "hstack",
        "spacing": 10,
        "children": [
          {
            "type": "box",
            "padding": 10,
            "radius": 12,
            "align": "center",
            "spacing": 0,
            "children": [
              {
                "type": "text",
                "text": "{{you}}",
                "size": 22,
                "weight": "bold",
                "design": "rounded",
                "lines": 1,
                "color": "orange"
              },
              {
                "type": "text",
                "text": "{{t.you}}",
                "style": "caption2",
                "color": "secondary",
                "lines": 1
              }
            ]
          },
          {
            "type": "box",
            "padding": 10,
            "radius": 12,
            "align": "center",
            "spacing": 0,
            "children": [
              {
                "type": "text",
                "text": "{{draws}}",
                "size": 22,
                "weight": "bold",
                "design": "rounded",
                "lines": 1,
                "color": "secondary"
              },
              {
                "type": "text",
                "text": "{{t.draws}}",
                "style": "caption2",
                "color": "secondary",
                "lines": 1
              }
            ]
          },
          {
            "type": "box",
            "padding": 10,
            "radius": 12,
            "align": "center",
            "spacing": 0,
            "children": [
              {
                "type": "text",
                "text": "{{mac}}",
                "size": 22,
                "weight": "bold",
                "design": "rounded",
                "lines": 1,
                "color": "blue"
              },
              {
                "type": "text",
                "text": "Mac ◯",
                "style": "caption2",
                "color": "secondary",
                "lines": 1
              }
            ]
          }
        ]
      },
      {
        "type": "list",
        "items": "{{cells}}",
        "columns": 3,
        "spacing": 10,
        "template": {
          "type": "box",
          "aspect": 1,
          "padding": 0,
          "radius": 18,
          "background": "{{item.bg}}",
          "opacity": "{{item.opacity}}",
          "action": "{{item.action}}",
          "children": [
            {
              "type": "text",
              "text": "{{item.mark}}",
              "size": 56,
              "weight": "bold",
              "color": "{{item.color}}"
            }
          ]
        }
      },
      {
        "type": "hstack",
        "spacing": 8,
        "children": [
          {
            "type": "text",
            "text": "{{status}}",
            "style": "title3",
            "weight": "bold",
            "color": "{{statusColor}}",
            "lines": 1
          },
          {
            "type": "spacer"
          },
          {
            "type": "button",
            "title": "{{t.newGame}}",
            "symbol": "arrow.clockwise",
            "action": "new",
            "color": "orange"
          }
        ]
      }
    ]
  },
