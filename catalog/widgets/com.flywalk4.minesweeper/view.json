{
  "full": {
    "type": "vstack",
    "spacing": 14,
    "align": "leading",
    "children": [
      {
        "type": "hstack",
        "spacing": 8,
        "children": [
          {
            "type": "hstack",
            "spacing": 6,
            "children": [
              {
                "type": "symbol",
                "name": "flag.fill",
                "color": "red",
                "size": 14
              },
              {
                "type": "text",
                "text": "{{t.header}}",
                "style": "caption",
                "weight": "bold",
                "color": "red"
              }
            ]
          },
          {
            "type": "spacer"
          },
          {
            "type": "text",
            "text": "{{t.best}} {{best}}",
            "style": "caption",
            "color": "secondary",
            "lines": 1
          }
        ]
      },
      {
        "type": "hstack",
        "spacing": 10,
        "children": [
          {
            "type": "box",
            "padding": 10,
            "radius": 12,
            "align": "center",
            "spacing": 0,
            "children": [
              {
                "type": "text",
                "text": "{{minesLeft}}",
                "size": 22,
                "weight": "bold",
                "design": "rounded",
                "lines": 1,
                "color": "red"
              },
              {
                "type": "text",
                "text": "{{t.minesLeft}}",
                "style": "caption2",
                "color": "secondary",
                "lines": 1
              }
            ]
          },
          {
            "type": "box",
            "padding": 8,
            "radius": 12,
            "align": "center",
            "fit": true,
            "action": "new",
            "children": [
              {
                "type": "text",
                "text": "{{face}}",
                "size": 24
              }
            ]
          },
          {
            "type": "box",
            "padding": 10,
            "radius": 12,
            "align": "center",
            "spacing": 0,
            "children": [
              {
                "type": "text",
                "text": "{{time}}",
                "size": 22,
                "weight": "bold",
                "design": "rounded",
                "lines": 1
              },
              {
                "type": "text",
                "text": "{{t.time}}",
                "style": "caption2",
                "color": "secondary",
                "lines": 1
              }
            ]
          }
        ]
      },
      {
        "type": "list",
        "items": "{{cells}}",
        "columns": 8,
        "spacing": 4,
        "template": {
          "type": "box",
          "aspect": 1,
          "padding": 0,
          "radius": 6,
          "background": "{{item.bg}}",
          "opacity": "{{item.opacity}}",
          "action": "{{item.action}}",
          "children": [
            {
              "type": "text",
              "text": "{{item.text}}",
              "size": 19,
              "weight": "heavy",
              "design": "rounded",
              "color": "{{item.color}}"
            }
          ]
        }
      },
      {
        "type": "text",
        "text": "{{status}}",
        "style": "headline",
        "color": "{{statusColor}}",
        "lines": 1
      },
      {
        "type": "hstack",
        "spacing": 8,
        "children": [
          {
            "type": "button",
            "title": "{{modeTitle}}",
            "symbol": "{{modeSymbol}}",
            "action": "mode"
          },
          {
            "type": "spacer"
          },
          {
            "type": "button",
            "title": "{{t.restart}}",
            "symbol": "arrow.clockwise",
            "action": "new",
            "color": "teal"
          }
        ]
      }
    ]
  },
