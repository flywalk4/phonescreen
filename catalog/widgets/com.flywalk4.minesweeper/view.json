{
  "full": {
    "type": "vstack",
    "spacing": 14,
    "align": "leading",
    "children": [
      {
        "type": "hstack",
        "spacing": 8,
        "children": [
          {
            "type": "text",
            "text": "🚩",
            "size": 14
          },
          {
            "type": "text",
            "text": "{{t.header}}",
            "style": "caption",
            "weight": "semibold",
            "color": "secondary"
          },
          {
            "type": "spacer"
          },
          {
            "type": "text",
            "text": "{{t.best}} {{best}}",
            "style": "caption",
            "color": "secondary"
          }
        ]
      },
      {
        "type": "hstack",
        "spacing": 10,
        "children": [
          {
            "type": "box",
            "padding": 10,
            "spacing": 0,
            "align": "center",
            "children": [
              {
                "type": "text",
                "text": "{{minesLeft}}",
                "size": 22,
                "weight": "bold",
                "design": "rounded",
                "color": "red"
              },
              {
                "type": "text",
                "text": "{{t.minesLeft}}",
                "style": "caption2",
                "color": "secondary"
              }
            ]
          },
          {
            "type": "box",
            "padding": 10,
            "align": "center",
            "action": "new",
            "children": [
              {
                "type": "text",
                "text": "{{face}}",
                "size": 30
              }
            ]
          },
          {
            "type": "box",
            "padding": 10,
            "spacing": 0,
            "align": "center",
            "children": [
              {
                "type": "text",
                "text": "{{time}}",
                "size": 22,
                "weight": "bold",
                "design": "rounded"
              },
              {
                "type": "text",
                "text": "{{t.time}}",
                "style": "caption2",
                "color": "secondary"
              }
            ]
          }
        ]
      },
      {
        "type": "spacer"
      },
      {
        "type": "list",
        "items": "{{cells}}",
        "columns": 8,
        "spacing": 4,
        "template": {
          "type": "box",
          "aspect": 1,
          "padding": 0,
          "radius": 6,
          "background": "{{item.bg}}",
          "opacity": "{{item.opacity}}",
          "action": "{{item.action}}",
          "children": [
            {
              "type": "text",
              "text": "{{item.text}}",
              "size": 19,
              "weight": "heavy",
              "design": "rounded",
              "color": "{{item.color}}"
            }
          ]
        }
      },
      {
        "type": "hstack",
        "children": [
          {
            "type": "text",
            "text": "{{status}}",
            "style": "headline",
            "color": "{{statusColor}}"
          },
          {
            "type": "spacer"
          }
        ]
      },
      {
        "type": "hstack",
        "spacing": 10,
        "children": [
          {
            "type": "button",
            "title": "{{modeTitle}}",
            "symbol": "{{modeSymbol}}",
            "action": "mode"
          },
          {
            "type": "spacer"
          },
          {
            "type": "button",
            "title": "{{t.restart}}",
            "symbol": "arrow.clockwise",
            "action": "new"
          }
        ]
      },
      {
        "type": "spacer"
      }
    ]
  },
  "medium": {
    "type": "vstack",
    "spacing": 0,
    "children": [
      {
        "type": "spacer"
      },
      {
        "type": "hstack",
        "spacing": 12,
        "children": [
          {
            "type": "vstack",
            "spacing": 0,
            "children": [
              {
                "type": "list",
                "items": "{{cells}}",
                "columns": 8,
                "spacing": 2,
                "template": {
                  "type": "box",
                  "aspect": 1,
                  "padding": 0,
                  "radius": 3,
                  "background": "{{item.bg}}",
                  "opacity": "{{item.opacity}}",
                  "action": "{{item.action}}",
                  "children": [
                    {
                      "type": "text",
                      "text": "{{item.text}}",
                      "size": 11,
                      "weight": "heavy",
                      "design": "rounded",
                      "color": "{{item.color}}"
                    }
                  ]
                }
              }
            ]
          },
          {
            "type": "vstack",
            "spacing": 6,
            "align": "leading",
            "children": [
              {
                "type": "text",
                "text": "{{face}}",
                "size": 28
              },
              {
                "type": "text",
                "text": "💣 {{minesLeft}}",
                "style": "subheadline",
                "weight": "semibold",
                "design": "rounded"
              },
              {
                "type": "text",
                "text": "⏱ {{time}}",
                "style": "subheadline",
                "design": "rounded",
                "color": "secondary"
              },
              {
                "type": "spacer"
              },
              {
                "type": "button",
                "title": "🚩",
                "action": "mode"
              },
              {
                "type": "button",
                "title": "{{t.restart}}",
                "action": "new"
              }
            ]
          }
        ]
      },
      {
        "type": "spacer"
      }
    ]
  },
  "small": {
    "type": "vstack",
    "spacing": 6,
    "align": "leading",
    "children": [
      {
        "type": "hstack",
        "spacing": 6,
        "children": [
          {
            "type": "text",
            "text": "{{face}}",
            "size": 17
          },
          {
            "type": "text",
            "text": "💣 {{minesLeft}}",
            "style": "caption",
            "weight": "semibold",
            "design": "rounded"
          },
          {
            "type": "spacer"
          },
          {
            "type": "text",
            "text": "⏱ {{time}}",
            "style": "caption",
            "design": "rounded",
            "color": "secondary"
          }
        ]
      },
      {
        "type": "list",
        "items": "{{cells}}",
        "columns": 8,
        "spacing": 1.5,
        "template": {
          "type": "box",
          "aspect": 1,
          "padding": 0,
          "radius": 2,
          "background": "{{item.bg}}",
          "opacity": "{{item.opacity}}",
          "action": "{{item.action}}",
          "children": [
            {
              "type": "text",
              "text": "{{item.text}}",
              "size": 9,
              "weight": "heavy",
              "design": "rounded",
              "color": "{{item.color}}"
            }
          ]
        }
      },
      {
        "type": "text",
        "text": "{{status}}",
        "style": "caption2",
        "color": "{{statusColor}}",
        "lines": 1
      },
      {
        "type": "spacer"
      },
      {
        "type": "hstack",
        "spacing": 6,
        "children": [
          {
            "type": "button",
            "title": "🚩",
            "action": "mode"
          },
          {
            "type": "spacer"
          },
          {
            "type": "button",
            "title": "{{t.restart}}",
            "action": "new"
          }
        ]
      }
    ]
  }
}
