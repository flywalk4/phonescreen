{
 "full": {
  "type": "vstack",
  "spacing": 14,
  "align": "leading",
  "children": [
   {
    "type": "hstack",
    "spacing": 8,
    "children": [
     {
      "type": "symbol",
      "name": "hourglass",
      "color": "blue",
      "size": 15
     },
     {
      "type": "text",
      "text": "ВРЕМЯ",
      "style": "caption",
      "weight": "semibold",
      "color": "secondary"
     },
     {
      "type": "spacer"
     },
     {
      "type": "text",
      "text": "{{date}}",
      "style": "caption",
      "color": "secondary"
     }
    ]
   },
   {
    "type": "box",
    "padding": 18,
    "spacing": 8,
    "children": [
     {
      "type": "hstack",
      "align": "baseline",
      "children": [
       {
        "type": "text",
        "text": "{{year}}",
        "style": "title3",
        "weight": "semibold",
        "color": "secondary"
       },
       {
        "type": "spacer"
       },
       {
        "type": "text",
        "text": "{{yearPct}}",
        "size": 56,
        "weight": "bold",
        "design": "rounded"
       }
      ]
     },
     {
      "type": "progress",
      "value": "{{yearValue}}",
      "color": "blue"
     },
     {
      "type": "text",
      "text": "{{yearLeft}}",
      "style": "footnote",
      "color": "secondary"
     }
    ]
   },
   {
    "type": "list",
    "items": "{{bars}}",
    "columns": 2,
    "spacing": 10,
    "template": {
     "type": "box",
     "padding": 12,
     "spacing": 6,
     "children": [
      {
       "type": "hstack",
       "children": [
        {
         "type": "text",
         "text": "{{item.title}}",
         "style": "caption",
         "weight": "semibold",
         "color": "secondary",
         "lines": 1
        },
        {
         "type": "spacer"
        }
       ]
      },
      {
       "type": "text",
       "text": "{{item.pct}}",
       "size": 24,
       "weight": "bold",
       "design": "rounded",
       "color": "{{item.color}}"
      },
      {
       "type": "progress",
       "value": "{{item.value}}",
       "color": "{{item.color}}"
      }
     ]
    }
   },
   {
    "type": "spacer"
   },
   {
    "type": "text",
    "text": "Отсчёты",
    "style": "headline",
    "if": "{{hasEvents}}"
   },
   {
    "type": "list",
    "items": "{{events}}",
    "spacing": 8,
    "template": {
     "type": "box",
     "padding": 12,
     "children": [
      {
       "type": "hstack",
       "spacing": 10,
       "children": [
        {
         "type": "vstack",
         "spacing": 1,
         "align": "leading",
         "children": [
          {
           "type": "text",
           "text": "{{item.name}}",
           "style": "headline",
           "lines": 1
          },
          {
           "type": "text",
           "text": "{{item.when}}",
           "style": "caption",
           "color": "secondary"
          }
         ]
        },
        {
         "type": "spacer"
        },
        {
         "type": "hstack",
         "align": "baseline",
         "spacing": 4,
         "children": [
          {
           "type": "text",
           "text": "{{item.count}}",
           "size": 26,
           "weight": "bold",
           "design": "rounded",
           "color": "{{item.color}}"
          },
          {
           "type": "text",
           "text": "{{item.unit}}",
           "style": "caption",
           "color": "secondary"
          }
         ]
        }
       ]
      }
     ]
    }
   }
  ]
 },
 "medium": {
  "type": "vstack",
  "spacing": 10,
  "align": "leading",
  "children": [
   {
    "type": "hstack",
    "align": "baseline",
    "children": [
     {
      "type": "text",
      "text": "{{year}}",
      "style": "subheadline",
      "weight": "semibold",
      "color": "secondary"
     },
     {
      "type": "spacer"
     },
     {
      "type": "text",
      "text": "{{yearPct}}",
      "size": 38,
      "weight": "bold",
      "design": "rounded"
     }
    ]
   },
   {
    "type": "list",
    "items": "{{bars}}",
    "spacing": 10,
    "template": {
     "type": "vstack",
     "spacing": 4,
     "align": "leading",
     "children": [
      {
       "type": "hstack",
       "children": [
        {
         "type": "text",
         "text": "{{item.title}}",
         "style": "caption",
         "color": "secondary",
         "lines": 1
        },
        {
         "type": "spacer"
        },
        {
         "type": "text",
         "text": "{{item.pct}}",
         "style": "caption",
         "weight": "semibold",
         "design": "rounded",
         "color": "{{item.color}}"
        }
       ]
      },
      {
       "type": "progress",
       "value": "{{item.value}}",
       "color": "{{item.color}}"
      }
     ]
    }
   },
   {
    "type": "spacer"
   },
   {
    "type": "box",
    "padding": 10,
    "if": "{{first}}",
    "children": [
     {
      "type": "hstack",
      "children": [
       {
        "type": "text",
        "text": "{{first.name}}",
        "style": "subheadline",
        "weight": "semibold",
        "lines": 1
       },
       {
        "type": "spacer"
       },
       {
        "type": "text",
        "text": "{{first.count}} {{first.unit}}",
        "style": "subheadline",
        "weight": "bold",
        "design": "rounded",
        "color": "orange"
       }
      ]
     }
    ]
   }
  ]
 },
 "small": {
  "type": "vstack",
  "spacing": 6,
  "align": "leading",
  "children": [
   {
    "type": "text",
    "text": "{{year}}",
    "style": "caption",
    "weight": "semibold",
    "color": "secondary"
   },
   {
    "type": "text",
    "text": "{{yearPct}}",
    "size": 34,
    "weight": "bold",
    "design": "rounded"
   },
   {
    "type": "list",
    "items": "{{bars}}",
    "spacing": 8,
    "template": {
     "type": "vstack",
     "spacing": 4,
     "align": "leading",
     "children": [
      {
       "type": "hstack",
       "children": [
        {
         "type": "text",
         "text": "{{item.title}}",
         "style": "caption",
         "color": "secondary",
         "lines": 1
        },
        {
         "type": "spacer"
        },
        {
         "type": "text",
         "text": "{{item.pct}}",
         "style": "caption",
         "weight": "semibold",
         "design": "rounded",
         "color": "{{item.color}}"
        }
       ]
      },
      {
       "type": "progress",
       "value": "{{item.value}}",
       "color": "{{item.color}}"
      }
     ]
    }
   },
   {
    "type": "spacer"
   },
   {
    "type": "text",
    "text": "{{first.name}}",
    "style": "caption",
    "color": "secondary",
    "lines": 1,
    "if": "{{first}}"
   },
   {
    "type": "text",
    "text": "{{first.count}} {{first.unit}}",
    "size": 22,
    "weight": "bold",
    "design": "rounded",
    "color": "{{first.color}}",
    "if": "{{first}}"
   }
  ]
 }
}