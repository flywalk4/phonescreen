{
  "full": {
    "type": "vstack", "spacing": 14, "align": "leading",
    "children": [
      { "type": "hstack", "spacing": 8, "children": [
        { "type": "symbol", "name": "chart.line.uptrend.xyaxis", "color": "green" },
        { "type": "text", "text": "Крипта и акции", "style": "title2" },
        { "type": "spacer" },
        { "type": "button", "title": "Обновить", "symbol": "arrow.clockwise", "action": "reload" }
      ]},
      { "type": "hstack", "align": "baseline", "spacing": 10, "children": [
        { "type": "text", "text": "{{main.name}}", "style": "headline", "color": "secondary" },
        { "type": "text", "text": "{{main.price}}", "style": "largeTitle", "lines": 1 },
        { "type": "spacer" },
        { "type": "text", "text": "{{main.change}}", "style": "headline", "color": "{{main.changeColor}}" }
      ]},
      { "type": "chart", "values": "{{chart}}", "color": "{{chartColor}}", "if": "{{hasChart}}" },
      { "type": "divider" },
      { "type": "list", "items": "{{rows}}", "spacing": 10, "template": {
        "type": "hstack", "spacing": 10, "children": [
          { "type": "text", "text": "{{item.name}}", "style": "headline", "lines": 1 },
          { "type": "spacer" },
          { "type": "text", "text": "{{item.price}}", "style": "body" },
          { "type": "text", "text": "{{item.change}}", "style": "subheadline", "color": "{{item.changeColor}}" }
        ]
      }},
      { "type": "spacer" },
      { "type": "text", "text": "{{warning}}", "style": "caption", "color": "orange", "if": "{{warning}}" },
      { "type": "text", "text": "Обновлено {{updated}} · CoinGecko, Мосбиржа", "style": "caption2", "color": "secondary" }
    ]
  },
  "medium": {
    "type": "vstack", "spacing": 6, "align": "leading",
    "children": [
      { "type": "chart", "values": "{{chart}}", "color": "{{chartColor}}", "if": "{{hasChart}}" },
      { "type": "list", "items": "{{rows}}", "spacing": 4, "template": {
        "type": "hstack", "spacing": 6, "children": [
          { "type": "text", "text": "{{item.ticker}}", "style": "subheadline", "lines": 1 },
          { "type": "spacer" },
          { "type": "text", "text": "{{item.price}}", "style": "subheadline" },
          { "type": "text", "text": "{{item.change}}", "style": "caption2", "color": "{{item.changeColor}}" }
        ]
      }}
    ]
  },
  "small": {
    "type": "vstack", "spacing": 4, "align": "leading",
    "children": [
      { "type": "text", "text": "{{main.name}}", "style": "caption", "color": "secondary", "lines": 1 },
      { "type": "text", "text": "{{main.price}}", "style": "title2", "lines": 1 },
      { "type": "text", "text": "{{main.change}}", "style": "caption", "color": "{{main.changeColor}}" },
      { "type": "chart", "values": "{{chart}}", "color": "{{chartColor}}", "if": "{{hasChart}}" }
    ]
  }
}
