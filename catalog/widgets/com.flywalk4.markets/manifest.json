{
  "id": "com.flywalk4.markets",
  "name": "Crypto & stocks",
  "version": "1.3.0",
  "author": "flywalk4",
  "description": "Crypto prices (CoinGecko) and Moscow Exchange stocks (ISS MOEX) with the day's change and a chart. No keys. Stocks come with the exchange's delay for free data (about 15 minutes).",
  "symbol": "chart.line.uptrend.xyaxis",
  "refresh": 300,
  "permissions": {
    "network": [
      "api.coingecko.com",
      "iss.moex.com"
    ]
  },
  "settings": [
    {
      "key": "crypto",
      "title": "Cryptocurrencies",
      "default": "BTC, ETH, TON",
      "hint": "Tickers or CoinGecko ids, comma-separated"
    },
    {
      "key": "currency",
      "title": "Crypto currency",
      "type": "choice",
      "default": "usd",
      "options": [
        {
          "value": "usd",
          "title": "USD"
        },
        {
          "value": "eur",
          "title": "EUR"
        },
        {
          "value": "rub",
          "title": "RUB"
        },
        {
          "value": "btc",
          "title": "BTC"
        }
      ]
    },
    {
      "key": "stocks",
      "title": "MOEX stocks",
      "default": "SBER, GAZP, YDEX",
      "hint": "Tickers, comma-separated"
    },
    {
      "key": "chart",
      "title": "Chart",
      "default": "",
      "hint": "A ticker; empty — the first in the list"
    }
  ]
}
