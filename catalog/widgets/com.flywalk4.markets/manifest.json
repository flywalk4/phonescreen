{
  "id": "com.flywalk4.markets",
  "name": "Крипта и акции",
  "version": "1.2.1",
  "author": "flywalk4",
  "description": "Цены криптовалют (CoinGecko) и акций Московской биржи (ISS MOEX) с изменением за день и графиком. Без ключей. Акции — с задержкой биржи для бесплатных данных (около 15 минут).",
  "symbol": "chart.line.uptrend.xyaxis",
  "refresh": 300,
  "permissions": {
    "network": [
      "api.coingecko.com",
      "iss.moex.com"
    ]
  },
  "settings": [
    {
      "key": "crypto",
      "title": "Криптовалюты",
      "default": "BTC, ETH, TON",
      "hint": "Тикеры или id CoinGecko через запятую"
    },
    {
      "key": "currency",
      "title": "Валюта для крипты",
      "type": "choice",
      "default": "usd",
      "options": [
        {
          "value": "usd",
          "title": "USD"
        },
        {
          "value": "eur",
          "title": "EUR"
        },
        {
          "value": "rub",
          "title": "RUB"
        },
        {
          "value": "btc",
          "title": "BTC"
        }
      ]
    },
    {
      "key": "stocks",
      "title": "Акции Мосбиржи",
      "default": "SBER, GAZP, YDEX",
      "hint": "Тикеры через запятую"
    },
    {
      "key": "chart",
      "title": "График",
      "default": "",
      "hint": "Тикер; пусто — первый в списке"
    }
  ]
}
