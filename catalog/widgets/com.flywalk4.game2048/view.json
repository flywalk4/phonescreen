{
  "full": {
    "type": "vstack",
    "spacing": 14,
    "align": "leading",
    "children": [
      {
        "type": "hstack",
        "spacing": 8,
        "children": [
          {
            "type": "text",
            "text": "2048",
            "size": 34,
            "weight": "heavy",
            "design": "rounded",
            "color": "#EDC22E"
          },
          {
            "type": "spacer"
          },
          {
            "type": "box",
            "padding": 10,
            "radius": 12,
            "align": "center",
            "spacing": 0,
            "children": [
              {
                "type": "text",
                "text": "{{score}}",
                "size": 22,
                "weight": "bold",
                "design": "rounded",
                "lines": 1
              },
              {
                "type": "text",
                "text": "{{t.score}}",
                "style": "caption2",
                "color": "secondary",
                "lines": 1
              }
            ],
            "fit": true
          },
          {
            "type": "box",
            "padding": 10,
            "radius": 12,
            "align": "center",
            "spacing": 0,
            "children": [
              {
                "type": "text",
                "text": "{{best}}",
                "size": 22,
                "weight": "bold",
                "design": "rounded",
                "lines": 1
              },
              {
                "type": "text",
                "text": "{{t.best}}",
                "style": "caption2",
                "color": "secondary",
                "lines": 1
              }
            ],
            "fit": true
          }
        ]
      },
      {
        "type": "box",
        "padding": 8,
        "radius": 14,
        "background": "#BBADA0",
        "opacity": 0.3,
        "children": [
          {
            "type": "list",
            "items": "{{tiles}}",
            "columns": 4,
            "spacing": 8,
            "template": {
              "type": "box",
              "aspect": 1,
              "padding": 0,
              "radius": 10,
              "background": "{{item.bg}}",
              "opacity": "{{item.opacity}}",
              "children": [
                {
                  "type": "text",
                  "text": "{{item.text}}",
                  "size": "{{item.size}}",
                  "weight": "bold",
                  "design": "rounded",
                  "color": "{{item.color}}"
                }
              ]
            }
          }
        ]
      },
      {
        "type": "text",
        "text": "{{status}}",
        "style": "subheadline",
        "weight": "semibold",
        "color": "{{statusColor}}",
        "lines": 1
      },
      {
        "type": "hstack",
        "spacing": 8,
        "children": [
          {
            "type": "button",
            "title": "",
            "symbol": "arrow.left",
            "action": "left"
          },
          {
            "type": "button",
            "title": "",
            "symbol": "arrow.up",
            "action": "up"
          },
          {
            "type": "button",
            "title": "",
            "symbol": "arrow.down",
            "action": "down"
          },
          {
            "type": "button",
            "title": "",
            "symbol": "arrow.right",
            "action": "right"
          },
          {
            "type": "spacer"
          },
          {
            "type": "button",
            "title": "{{t.newGame}}",
            "symbol": "arrow.clockwise",
            "action": "new",
            "color": "orange"
          }
        ]
      }
    ]
  },
