        {
         "type": "string",
         "pattern": "\\{\\{.+\\}\\}"
        },
        {
         "type": "null"
        }
       ]
      },
      "kind": {
       "anyOf": [
        {
         "enum": [
          "aurora",
          "stars",
          "matrix",
          "waves",
          "bokeh",
          "lava",
          "snow",
          "rain",
          "gradient"
